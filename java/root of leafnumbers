/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public int sumNumbers(TreeNode root) {
        // Start recursion with an initial sum of 0
        return dfs(root, 0);
    }

    private int dfs(TreeNode node, int currentSum) {
        // Base case: if node is null, contribute 0 to the sum
        if (node == null) {
            return 0;
        }

        // Calculate current value for this path (previous sum * 10 + current node value)
        currentSum = currentSum * 10 + node.val;

        // If it's a leaf node, return the final value of this path
        if (node.left == null && node.right == null) {
            return currentSum;
        }

        // Recursively calculate sum for left and right subtrees
        return dfs(node.left, currentSum) + dfs(node.right, currentSum);
    }
}
